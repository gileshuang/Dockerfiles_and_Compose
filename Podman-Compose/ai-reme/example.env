# 复制为 .env 后按需填写；本文件仅列出验证/部署真正用到的变量。

# Optional container settings.
# REME_TIMEZONE=Asia/Shanghai
# REME_CONFIG=/etc/reme/config.yaml
# REME_IMAGE=ghcr.io/agentscope-ai/reme:main

# ---- 数据与端口 ----
# 记忆工作区在宿主上的绝对路径（Markdown 就落在这里）
REME_DATA_DIR=./data
# 只监听回环；需要被其他机器上的 agent 访问时改成 0.0.0.0，并自行加认证/ACL
REME_BIND_ADDRESS=127.0.0.1
REME_PUBLISHED_PORT=2333
REME_PORT=2333

# ---- 运行用户（bind mount 归属）----
REME_UID=1000
REME_GID=100

# ---- LLM：auto_memory / auto_dream 需要；不填则仅自动记录与检索可用 ----
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-plus

# ---- 向量检索（可选）：不填则退化为 BM25 关键词检索 ----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
